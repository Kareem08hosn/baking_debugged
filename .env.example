# Copy this file to .env.local and fill in the values. .env.local is never
# committed; this template is, so it must never contain real values.

# Supabase (Project Settings -> API keys). Safe for the browser: Row Level
# Security decides what these can do.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The site's public address once deployed (sitemap, link previews).
# Leave empty locally.
NEXT_PUBLIC_SITE_URL=

# ---- Server only: NEVER give these a NEXT_PUBLIC_ name ----

# Supabase secret key: lets the server write the AI cache and daily limits,
# and lets `npm run embed` store recipe embeddings.
SUPABASE_SECRET_KEY=

# Gemini API key from Google AI Studio. The AI features switch on when this
# and SUPABASE_SECRET_KEY are both set.
GEMINI_API_KEY=

# Optional overrides (defaults in lib/ai/config.js)
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_EMBED_MODEL=gemini-embedding-2
# AI_DAILY_LIMIT=25
